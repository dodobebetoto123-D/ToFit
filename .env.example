# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) 에서 값을 복사한다.
# 이 파일을 `.env.local` 로 복사한 뒤 값을 채울 것. `.env.local` 은 커밋하지 않는다.
# Vite 는 VITE_ 접두사가 붙은 변수만 클라이언트에 노출한다. (import.meta.env 로 읽는다)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI 기능(옷 사진 분류 · 코디 문구 생성)을 중계하는 Cloudflare Worker 주소.
# Groq API 키는 여기가 아니라 Worker 시크릿에만 둔다 — 배포 방법은 worker/README.md 참고.
# 비워두면 AI 없이 규칙 기반 로직만 동작한다.
VITE_AI_PROXY_URL=

# ⚠️ VITE_GROQ_API_KEY는 더 이상 쓰지 않는다.
# VITE_ 접두사가 붙은 값은 빌드 산출물에 그대로 박혀 누구나 꺼내 볼 수 있다.
# 예전에 이 항목을 채워 배포한 적이 있다면 해당 키는 유출된 것이니 폐기하고 재발급할 것.

# 공공데이터포털(data.go.kr) 마이페이지 > 활용신청 현황 > 기상청_단기예보((구)동네예보) 조회서비스
VITE_KMA_SERVICE_KEY=

# 카카오 애드핏(https://adfit.kakao.com) > 광고 관리 > 광고단위 추가에서 발급받은 광고단위 ID.
# 비워두면 광고 영역 자체가 렌더링되지 않는다 (빈 자리로 남지 않는다).
VITE_ADFIT_UNIT_ID=
